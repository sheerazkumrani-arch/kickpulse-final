{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/articles/:old(Orlando[^/]+)",
      "destination": "/articles/orlando-city-vs-fc-cincinnati-preview/",
      "permanent": true
    },
    {
      "source": "/articles/:old(Orlando[^/]+)/",
      "destination": "/articles/orlando-city-vs-fc-cincinnati-preview/",
      "permanent": true
    },
    {
      "source": "/articles/orlando-city-vs-fc-cincinnati-prediction-preview-team-news-lineups{/}?",
      "destination": "/articles/orlando-city-vs-fc-cincinnati-preview/",
      "permanent": true
    },
    {
      "source": "/category/mls-match-preview{/}?",
      "destination": "/category/match-previews/",
      "permanent": true
    },
    {
      "source": "/articles/urdu-article{/}?",
      "destination": "/articles/inter-miami-playoffs-messi-title-defence-ur/",
      "permanent": true
    },
    {
      "source": "/articles/urdu-version-full{/}?",
      "destination": "/articles/pochettino-record-against-liverpool-anfield-debut-ur/",
      "permanent": true
    },
    {
      "source": "/category/articles{/}?",
      "destination": "/articles/",
      "permanent": true
    }
  ],
  "trailingSlash": true
}